        "\n",
        "def simulate_priority_aging(processes, aging_interval=3, use_aging=True):\n",
        "    if aging_interval <= 0:\n",
        "        raise ValueError(\"aging_interval должен быть больше 0\")\n",
        "\n",
        "    jobs = []\n",
        "    for p in processes:\n",
        "        jobs.append({\n",
        "            **p,\n",
        "            \"remaining\": p[\"burst\"],\n",
        "            \"first_start\": None,\n",
        "            \"completion\": None,\n",
        "            \"ready_since\": p[\"arrival\"],\n",
        "            \"waited\": 0,\n",
        "        })\n",
        "\n",
        "    time = 0\n",
        "    completed = 0\n",
        "    timeline = []\n",
        "    n = len(jobs)\n",
        "    current = None\n",
        "\n",
        "    while completed < n:\n",
        "        available = [\n",
        "            p for p in jobs\n",
        "            if p[\"arrival\"] <= time and p[\"remaining\"] > 0\n",
        "        ]\n",
        "\n",
        "        if not available:\n",
        "            next_time = min(\n",
        "                p[\"arrival\"] for p in jobs\n",
        "                if p[\"remaining\"] > 0 and p[\"arrival\"] > time\n",
        "            )\n",
        "            if timeline and timeline[-1][2] == \"IDLE\":\n",
        "                timeline[-1] = (timeline[-1][0], next_time, \"IDLE\")\n",
        "            else:\n",
        "                timeline.append((time, next_time, \"IDLE\"))\n",
        "            time = next_time\n",
        "            current = None\n",
        "            continue\n",
        "\n",
        "        def effective_priority(p):\n",
        "            bonus = (\n",
        "                int(p[\"waited\"] // aging_interval)\n",
        "                if use_aging else 0\n",
        "            )\n",
        "            return p[\"priority\"] - bonus\n",
        "\n",
        "        chosen = min(\n",
        "            available,\n",
        "            key=lambda p: (\n",
        "                effective_priority(p),\n",
        "                p[\"arrival\"],\n",
        "                p[\"id\"]\n",
        "            )\n",
        "        )\n",
        "\n",
        "        if chosen[\"first_start\"] is None:\n",
        "            chosen[\"first_start\"] = time\n",
        "\n",
        "        if timeline and timeline[-1][2] == chosen[\"id\"]:\n",
        "            timeline[-1] = (\n",
        "                timeline[-1][0], time + 1, chosen[\"id\"]\n",
        "            )\n",
        "        else:\n",
        "            timeline.append((time, time + 1, chosen[\"id\"]))\n",
        "\n",
        "        for p in available:\n",
        "            if p is not chosen:\n",
        "                p[\"waited\"] += 1\n",
        "\n",
        "        chosen[\"remaining\"] -= 1\n",
        "        time += 1\n",
        "\n",
        "        if chosen[\"remaining\"] == 0:\n",
        "            chosen[\"completion\"] = time\n",
        "            completed += 1\n",
        "\n",
        "    return timeline\n",
        "\n",
        "\n",
        "aging_set = [\n",
        "    {\"id\": \"P1\", \"arrival\": 0, \"burst\": 12, \"priority\": 3},\n",
        "    {\"id\": \"P2\", \"arrival\": 0, \"burst\": 3, \"priority\": 0},\n",
        "    {\"id\": \"P3\", \"arrival\": 1, \"burst\": 3, \"priority\": 0},\n",
        "    {\"id\": \"P4\", \"arrival\": 2, \"burst\": 3, \"priority\": 0},\n",
        "    {\"id\": \"P5\", \"arrival\": 3, \"burst\": 3, \"priority\": 0},\n",
        "    {\"id\": \"P6\", \"arrival\": 4, \"burst\": 3, \"priority\": 0},\n",
        "]\n",
        "\n",
        "without_aging = simulate_priority_aging(\n",
        "    aging_set, aging_interval=3, use_aging=False\n",
        ")\n",
        "\n",
        "with_aging = simulate_priority_aging(\n",
        "    aging_set, aging_interval=3, use_aging=True\n",
        ")\n",
        "\n",
        "print(\"Priority без Aging:\")\n",
        "print(without_aging)\n",
        "\n",
        "print(\"\\nPriority с Aging:\")\n",
        "print(with_aging)\n"
