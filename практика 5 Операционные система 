    "\n",
    "def count_switches(timeline):\n",
    "    \"\"\"Считает переходы между разными процессами, не считая простой CPU.\"\"\"\n",
    "    switches = 0\n",
    "    for previous, current in zip(timeline, timeline[1:]):\n",
    "        previous_pid = previous[2]\n",
    "        current_pid = current[2]\n",
    "        if (\n",
    "            previous_pid != \"IDLE\"\n",
    "            and current_pid != \"IDLE\"\n",
    "            and previous_pid != current_pid\n",
    "        ):\n",
    "            switches += 1\n",
    "    return switches\n",
