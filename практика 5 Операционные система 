        "\n",
        "def simulate(processes, algorithm, **params):\n",
        "    \"\"\"\n",
        "    Возвращает интервалы:\n",
        "    (start, end, process_id)\n",
        "\n",
        "    Для простоя CPU process_id = \"IDLE\".\n",
        "    Меньшее значение priority означает более высокий приоритет.\n",
        "    \"\"\"\n",
        "    if not processes:\n",
        "        return []\n",
        "\n",
        "    algorithm = algorithm.upper()\n",
        "    valid = {\"FCFS\", \"SJF\", \"SRTF\", \"PRIORITY\", \"RR\"}\n",
        "\n",
        "    if algorithm not in valid:\n",
        "        raise ValueError(f\"Неизвестный алгоритм: {algorithm}\")\n",
        "\n",
        "    jobs = []\n",
        "    for p in processes:\n",
        "        job = dict(p)\n",
        "        job[\"id\"] = str(p[\"id\"])\n",
        "        job[\"arrival\"] = int(p[\"arrival\"])\n",
        "        job[\"burst\"] = int(p[\"burst\"])\n",
        "        job[\"priority\"] = int(p.get(\"priority\", 0))\n",
        "\n",
        "        if job[\"arrival\"] < 0 or job[\"burst\"] <= 0:\n",
        "            raise ValueError(\"arrival должен быть >= 0, burst должен быть > 0\")\n",
        "\n",
        "        job[\"remaining\"] = job[\"burst\"]\n",
        "        jobs.append(job)\n",
        "\n",
        "    if len({p[\"id\"] for p in jobs}) != len(jobs):\n",
        "        raise ValueError(\"ID процессов должны быть уникальными\")\n",
        "\n",
        "    jobs.sort(key=lambda p: (p[\"arrival\"], p[\"id\"]))\n",
        "    timeline = []\n",
        "    time = 0\n",
        "    completed = 0\n",
        "    n = len(jobs)\n",
        "    ready = deque()\n",
        "    added = set()\n",
        "    current = None\n",
        "    quantum = int(params.get(\"quantum\", params.get(\"q\", 2)))\n",
        "    aging = float(params.get(\"aging\", 0))\n",
        "\n",
        "    if algorithm == \"RR\" and quantum <= 0:\n",
        "        raise ValueError(\"Квант RR должен быть положительным\")\n",
        "    if aging < 0:\n",
        "        raise ValueError(\"aging не может быть отрицательным\")\n",
        "\n",
        "    def record(start, end, pid):\n",
        "        if start == end:\n",
        "            return\n",
        "        if timeline and timeline[-1][2] == pid and timeline[-1][1] == start:\n",
        "            timeline[-1] = (timeline[-1][0], end, pid)\n",
        "        else:\n",
        "            timeline.append((start, end, pid))\n",
        "\n",
        "    def add_arrivals(t):\n",
        "        for j in jobs:\n",
        "            if j[\"arrival\"] <= t and j[\"id\"] not in added:\n",
        "                ready.append(j)\n",
        "                added.add(j[\"id\"])\n",
        "\n",
        "    while completed < n:\n",
        "        add_arrivals(time)\n",
        "\n",
        "        if algorithm in (\"FCFS\", \"RR\"):\n",
        "            if current is None:\n",
        "                if not ready:\n",
        "                    next_time = min(\n",
        "                        j[\"arrival\"] for j in jobs\n",
        "                        if j[\"id\"] not in added\n",
        "                    )\n",
        "                    record(time, next_time, \"IDLE\")\n",
        "                    time = next_time\n",
        "                    add_arrivals(time)\n",
        "\n",
        "                current = ready.popleft()\n",
        "\n",
        "            if algorithm == \"FCFS\":\n",
        "                duration = current[\"remaining\"]\n",
        "                start = time\n",
        "                end = time + duration\n",
        "                record(start, end, current[\"id\"])\n",
        "                time = end\n",
        "                current[\"remaining\"] = 0\n",
        "                completed += 1\n",
        "                current = None\n",
        "\n",
        "            else:\n",
        "                duration = min(quantum, current[\"remaining\"])\n",
        "                start = time\n",
        "                end = time + duration\n",
        "                record(start, end, current[\"id\"])\n",
        "                time = end\n",
        "                current[\"remaining\"] -= duration\n",
        "                add_arrivals(time)\n",
        "\n",
        "                if current[\"remaining\"] == 0:\n",
        "                    completed += 1\n",
        "                else:\n",
        "                    ready.append(current)\n",
        "                current = None\n",
        "\n",
        "        else:\n",
        "            if not ready:\n",
        "                future = [\n",
        "                    j[\"arrival\"] for j in jobs\n",
        "                    if j[\"id\"] not in added\n",
        "                ]\n",
        "                if future:\n",
        "                    next_time = min(future)\n",
        "                    record(time, next_time, \"IDLE\")\n",
        "                    time = next_time\n",
        "                    add_arrivals(time)\n",
        "\n",
        "            if algorithm == \"SJF\":\n",
        "                chosen = min(\n",
        "                    ready,\n",
        "                    key=lambda j: (j[\"burst\"], j[\"arrival\"], j[\"id\"])\n",
        "                )\n",
        "                ready.remove(chosen)\n",
        "                start = time\n",
        "                end = time + chosen[\"remaining\"]\n",
        "                record(start, end, chosen[\"id\"])\n",
        "                time = end\n",
        "                chosen[\"remaining\"] = 0\n",
        "                completed += 1\n",
        "\n",
        "                # SJF runs the selected process to completion.\n",
        "                continue\n",
        "\n",
        "            if algorithm == \"SRTF\":\n",
        "                chosen = min(\n",
        "                    ready,\n",
        "                    key=lambda j: (\n",
        "                        j[\"remaining\"], j[\"arrival\"], j[\"id\"]\n",
        "                    )\n",
        "                )\n",
        "            else:  # Preemptive Priority\n",
        "                def effective_priority(j):\n",
        "                    waited = max(0, time - j[\"arrival\"] -\n",
        "                                 (j[\"burst\"] - j[\"remaining\"]))\n",
        "                    # Aging applies to waiting time approximately here.\n",
        "                    return j[\"priority\"] - (\n",
        "                        waited / aging if aging > 0 else 0\n",
        "                    )\n",
        "\n",
        "                chosen = min(\n",
        "                    ready,\n",
        "                    key=lambda j: (\n",
        "                        effective_priority(j),\n",
        "                        j[\"arrival\"], j[\"id\"]\n",
        "                    )\n",
        "                )\n",
        "\n",
        "            # Run one time unit, checking arrivals and preemption.\n",
        "            record(time, time + 1, chosen[\"id\"])\n",
        "            chosen[\"remaining\"] -= 1\n",
        "            time += 1\n",
        "\n",
        "            if chosen[\"remaining\"] == 0:\n",
        "                ready.remove(chosen)\n",
        "                completed += 1\n",
        "\n",
        "    return timeline\n",
        "\n",
        "\n",
        "print(\"Все 5 алгоритмов реализованы.\")\n"
      ],
