    "\n",
    "# Каждый процесс:\n",
    "# id — имя процесса\n",
    "# arrival — время поступления\n",
    "# burst — время выполнения\n",
    "# priority — приоритет (меньшее число = выше приоритет)\n",
    "\n",
    "set1 = [\n",
    "    {\"id\": \"P1\", \"arrival\": 0, \"burst\": 7, \"priority\": 3},\n",
    "    {\"id\": \"P2\", \"arrival\": 2, \"burst\": 4, \"priority\": 1},\n",
    "    {\"id\": \"P3\", \"arrival\": 4, \"burst\": 1, \"priority\": 4},\n",
    "    {\"id\": \"P4\", \"arrival\": 5, \"burst\": 4, \"priority\": 2},\n",
    "]\n",
    "\n",
    "set2 = [\n",
    "    {\"id\": \"P1\", \"arrival\": 0, \"burst\": 8, \"priority\": 3},\n",
    "    {\"id\": \"P2\", \"arrival\": 1, \"burst\": 4, \"priority\": 2},\n",
    "    {\"id\": \"P3\", \"arrival\": 2, \"burst\": 9, \"priority\": 4},\n",
    "    {\"id\": \"P4\", \"arrival\": 3, \"burst\": 5, \"priority\": 1},\n",
    "]\n",
    "\n",
    "print(\"Set1:\")\n",
    "display(pd.DataFrame(set1))\n",
    "\n",
    "print(\"Set2:\")\n",
    "display(pd.DataFrame(set2))\n"
