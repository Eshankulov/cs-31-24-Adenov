    "def simulate_priority_aging(processes, aging_interval=3, use_aging=True):\n",
    "    if aging_interval <= 0:\n",
    "        raise ValueError(\"aging_interval должен быть больше 0\")\n",
    "\n",
    "    jobs = []\n",
    "    for p in processes:\n",
    "        jobs.append({\n",
    "            **p,\n",
    "            \"remaining\": p[\"burst\"],\n",
    "            \"first_start\": None,\n",
    "            \"completion\": None,\n",
    "            \"ready_since\": p[\"arrival\"],\n",
    "            \"waited\": 0,\n",
    "        })\n",
    "\n",
    "    time = 0\n",
    "    completed = 0\n",
    "    timeline = []\n",
    "    n = len(jobs)\n",
    "    current = None\n",
    "\n",
    "    while completed < n:\n",
    "        available = [\n",
    "            p for p in jobs\n",
    "            if p[\"arrival\"] <= time and p[\"remaining\"] > 0\n",
