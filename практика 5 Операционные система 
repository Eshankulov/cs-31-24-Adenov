    "\n",
    "def calculate_metrics(processes, timeline):\n",
    "    stats = {}\n",
    "\n",
    "    for p in processes:\n",
    "        stats[p[\"id\"]] = {\n",
    "            \"arrival\": p[\"arrival\"],\n",
    "            \"burst\": p[\"burst\"],\n",
    "            \"first_start\": None,\n",
    "            \"completion\": None,\n",
    "            \"executed\": 0,\n",
    "        }\n",
    "\n",
    "    for start, end, pid in timeline:\n",
    "        if pid == \"IDLE\":\n",
    "            continue\n",
    "\n",
    "        s = stats[pid]\n",
    "        if s[\"first_start\"] is None:\n",
    "            s[\"first_start\"] = start\n",
    "\n",
    "        s[\"completion\"] = end\n",
    "        s[\"executed\"] += end - start\n",
    "\n",
    "    for pid, s in stats.items():\n",
    "        s[\"turnaround\"] = s[\"completion\"] - s[\"arrival\"]\n",
    "        s[\"waiting\"] = s[\"turnaround\"] - s[\"burst\"]\n",
    "        s[\"response\"] = s[\"first_start\"] - s[\"arrival\"]\n",
    "\n",
    "    total_time = timeline[-1][1] if timeline else 0\n",
    "    busy_time = sum(\n",
    "        end - start for start, end, pid in timeline\n",
    "        if pid != \"IDLE\"\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"avg_waiting\": sum(s[\"waiting\"] for s in stats.values()) / len(stats),\n",
    "        \"avg_turnaround\": sum(s[\"turnaround\"] for s in stats.values()) / len(stats),\n",
    "        \"avg_response\": sum(s[\"response\"] for s in stats.values()) / len(stats),\n",
    "        \"cpu_utilization\": 100 * busy_time / total_time if total_time else 0,\n",
    "    }\n",
    "\n",
    "\n",
    "rows = []\n",
    "\n",
    "for algorithm in [\"FCFS\", \"SJF\", \"SRTF\", \"PRIORITY\", \"RR\"]:\n",
    "    timeline = simulate(\n",
    "        set1, algorithm, quantum=3, aging=5\n",
    "    )\n",
    "    metrics = calculate_metrics(set1, timeline)\n",
    "    rows.append({\"Algorithm\": algorithm, **metrics})\n",
    "\n",
    "display(pd.DataFrame(rows).round(2))\n"
