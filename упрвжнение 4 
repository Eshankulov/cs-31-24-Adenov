        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Создаём 10 случайных чисел от 0 до 99\n",
        "numbers = np.random.randint(0, 100, 10)\n",
        "\n",
        "# Получаем цифры десятков\n",
        "tens = numbers // 10\n",
        "\n",
        "# Создаём Series\n",
        "series = pd.Series(tens)\n",
        "\n",
        "# Выводим результат\n",
        "print(\"Исходные числа:\")\n",
        "print(numbers)\n",
        "\n",
        "print(\"\\nЦифры десятков:\")\n",
        "print(series)"
